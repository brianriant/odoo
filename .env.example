# Database Configuration
DB_NAME=odoo
DB_USER=odoo
DB_PASSWORD=your_secure_password_here
DB_HOST=db
DB_PORT=5432

# Odoo Configuration
ODOO_PORT=8069
ODOO_CHAT_PORT=8072

# Additional Odoo Arguments (optional)
# Examples:
# ODOO_EXTRA_ARGS=--dev=all
# ODOO_EXTRA_ARGS=--workers=4 --max-cron-threads=2
# ODOO_EXTRA_ARGS=--test-enable --test-tags /module_name --stop-after-init
ODOO_EXTRA_ARGS=

# Admin Master Password (set for production)
# ADMIN_PASSWORD=your_admin_master_password

# Email Configuration (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password
# SMTP_SSL=True
